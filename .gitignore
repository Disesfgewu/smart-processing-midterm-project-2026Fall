# 模型、資料集、訓練輸出（體積大，不進版控）
data/*
# 量測原始資料（體積小）要進版控，讓 docs/ 裡的數字可以重算；模型、引擎、資料集、大型日誌仍然不進
!data/bench/
data/bench/*
!data/bench/jetson/
!data/bench/wsl/

# 測試輸出
out*.png
out*.jpg
out*.mp4

# Python / 環境
__pycache__/
*.egg-info/
.venv-jetson/

# 日誌
*.log

# 例外：量測證據（放在 *.log 規則之後才會生效）
!data/bench/jetson/tegrastats_*.log
!data/bench/jetson/build_*.log
!data/bench/jetson/e2e_*_tegra.log
